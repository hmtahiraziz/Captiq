NODE_ENV=development
PORT=3001

# Neon Postgres — production must include sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Use separate secrets per environment (never reuse staging keys in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!

OPENAI_API_KEY=sk-...
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Development may use *. Production must be an explicit comma-separated allow-list.
CORS_ORIGIN=*
# Production example:
# CORS_ORIGIN=https://captiq.ai,https://www.captiq.ai

# Email via Resend (required in production) — sends 6-digit password reset codes
RESEND_API_KEY=
EMAIL_FROM=
# Dev testing: Captiq AI <onboarding@resend.dev> (can only send to your Resend account email)

# HTTP Basic Auth for Swagger UI (/api/docs) and OpenAPI JSON (/api/docs.json)
# Defaults to admin/admin in development. Must be changed in production.
